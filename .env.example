# ====================================================================
# AeroCast — Atmospheric Weather Telemetry Portal Environment Settings
# (Template file: Copy to .env and fill in your API key)
# ====================================================================

# --------------------------------------------------------------------
# 1. Weather API Connection Key
# --------------------------------------------------------------------
# Option A: WeatherAPI.com (Recommended — provides current, 7-day forecast, hourly & AQI)
# Get your free API key at: https://www.weatherapi.com/signup.aspx
VITE_WEATHER_API_KEY=your_weatherapi_key_here
VITE_WEATHER_API_PROVIDER=weatherapi

# Option B: OpenWeatherMap (Alternative)
# Get your free API key at: https://openweathermap.org/api
# VITE_WEATHER_API_KEY=your_openweathermap_key_here
# VITE_WEATHER_API_PROVIDER=openweathermap

# --------------------------------------------------------------------
# 2. Portal Configuration Defaults
# --------------------------------------------------------------------
# Default observatory city on launch (Indian observatory by default)
VITE_DEFAULT_CITY=New Delhi

# Default temperature unit: 'C' (Celsius) or 'F' (Fahrenheit)
VITE_DEFAULT_UNIT=C

# Default portal language: 'en' (English) or 'hi' (Hindi)
VITE_DEFAULT_LANG=en
